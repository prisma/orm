// use prisma-8

namespace public {
  model User {
    id Int @id
  }
}

namespace finance {
  model Bill {
    id       Int       @id
    number   String    @unique
    status   String
    receipts Receipt[]

    @@index([status])
    @@rls
  }

  model Receipt {
    id        Int  @id
    invoiceId Int
    invoice   Bill @relation(fields: [invoiceId], references: [id])
  }

  policy_select invoice_read {
    target = Bill
    roles  = [app_user]
    using  = sql`(id > 0)`
  }
}
