[
  {
    "id": "index.posts.create(title_1)",
    "label": "Create index title_1 on posts (title:1)",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "no index named title_1 exists on posts",
        "source": {
          "kind": "listIndexes",
          "collection": "posts"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "title_1"
        },
        "expect": "notExists",
        "object": "an index named \"title_1\" in \"posts\""
      },
      {
        "description": "no index with the same keys and options exists on posts",
        "source": {
          "kind": "listIndexes",
          "collection": "posts"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "key",
              "op": "$eq",
              "value": {
                "title": 1
              }
            },
            {
              "kind": "not",
              "expr": {
                "kind": "field",
                "field": "unique",
                "op": "$eq",
                "value": true
              }
            },
            {
              "kind": "not",
              "expr": {
                "kind": "field",
                "field": "sparse",
                "op": "$eq",
                "value": true
              }
            },
            {
              "kind": "exists",
              "field": "expireAfterSeconds",
              "exists": false
            },
            {
              "kind": "exists",
              "field": "partialFilterExpression",
              "exists": false
            },
            {
              "kind": "exists",
              "field": "wildcardProjection",
              "exists": false
            },
            {
              "kind": "exists",
              "field": "collation",
              "exists": false
            }
          ]
        },
        "expect": "notExists",
        "object": "an index on { title: 1 } in \"posts\""
      }
    ],
    "execute": [
      {
        "description": "create index title_1 on posts",
        "command": {
          "kind": "createIndex",
          "collection": "posts",
          "keys": [
            {
              "direction": 1,
              "field": "title"
            }
          ],
          "name": "title_1"
        }
      }
    ],
    "postcheck": [
      {
        "description": "index title_1 exists on posts",
        "source": {
          "kind": "listIndexes",
          "collection": "posts"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "name",
              "op": "$eq",
              "value": "title_1"
            },
            {
              "kind": "and",
              "exprs": [
                {
                  "kind": "field",
                  "field": "key",
                  "op": "$eq",
                  "value": {
                    "title": 1
                  }
                },
                {
                  "kind": "not",
                  "expr": {
                    "kind": "field",
                    "field": "unique",
                    "op": "$eq",
                    "value": true
                  }
                },
                {
                  "kind": "not",
                  "expr": {
                    "kind": "field",
                    "field": "sparse",
                    "op": "$eq",
                    "value": true
                  }
                },
                {
                  "kind": "exists",
                  "field": "expireAfterSeconds",
                  "exists": false
                },
                {
                  "kind": "exists",
                  "field": "partialFilterExpression",
                  "exists": false
                },
                {
                  "kind": "exists",
                  "field": "wildcardProjection",
                  "exists": false
                },
                {
                  "kind": "exists",
                  "field": "collation",
                  "exists": false
                }
              ]
            }
          ]
        },
        "expect": "exists"
      }
    ]
  },
  {
    "id": "validator.users.update",
    "label": "Update validator on users (added: bio)",
    "operationClass": "widening",
    "precheck": [
      {
        "description": "collection users exists",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "users"
        },
        "expect": "exists",
        "object": "collection \"users\""
      },
      {
        "description": "every document in users fits the new validator",
        "source": {
          "collection": "users",
          "command": {
            "kind": "rawAggregate",
            "collection": "users",
            "pipeline": [
              {
                "$match": {
                  "$nor": [
                    {
                      "$jsonSchema": {
                        "additionalProperties": false,
                        "bsonType": "object",
                        "properties": {
                          "_id": {
                            "bsonType": "objectId"
                          },
                          "bio": {
                            "bsonType": [
                              "null",
                              "string"
                            ]
                          },
                          "email": {
                            "bsonType": "string"
                          },
                          "name": {
                            "bsonType": "string"
                          }
                        },
                        "required": [
                          "_id",
                          "email",
                          "name"
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "$limit": 1
              }
            ]
          },
          "meta": {
            "target": "mongo",
            "storageHash": "",
            "lane": "mongo-raw"
          }
        },
        "filter": {
          "kind": "exists",
          "field": "_id",
          "exists": true
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "modify users",
        "command": {
          "kind": "collMod",
          "collection": "users",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "bio": {
                  "bsonType": [
                    "null",
                    "string"
                  ]
                },
                "email": {
                  "bsonType": "string"
                },
                "name": {
                  "bsonType": "string"
                }
              },
              "required": [
                "_id",
                "email",
                "name"
              ]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": [
      {
        "description": "validator applied on users",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "name",
              "op": "$eq",
              "value": "users"
            },
            {
              "kind": "field",
              "field": "options.validationLevel",
              "op": "$eq",
              "value": "strict"
            },
            {
              "kind": "field",
              "field": "options.validationAction",
              "op": "$eq",
              "value": "error"
            },
            {
              "kind": "field",
              "field": "options.validator.$jsonSchema",
              "op": "$eq",
              "value": {
                "additionalProperties": false,
                "bsonType": "object",
                "properties": {
                  "_id": {
                    "bsonType": "objectId"
                  },
                  "bio": {
                    "bsonType": [
                      "null",
                      "string"
                    ]
                  },
                  "email": {
                    "bsonType": "string"
                  },
                  "name": {
                    "bsonType": "string"
                  }
                },
                "required": [
                  "_id",
                  "email",
                  "name"
                ]
              }
            }
          ]
        },
        "expect": "exists"
      }
    ]
  }
]