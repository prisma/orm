// use prisma-8

model User {
  id    ObjectId @id @map("_id")
  name  String
  email String
  bio   String?
  posts Post[]
  @@map("users")
}

model Post {
  id       ObjectId @id @map("_id")
  title    String
  authorId ObjectId
  author   User @relation(fields: [authorId], references: [id])
  @@index([authorId])
  @@index([title])
  @@map("posts")
}
