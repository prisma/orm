[
  {
    "id": "data_transform.User.name",
    "label": "Data transform: User.name",
    "operationClass": "data",
    "name": "User.name",
    "invariantId": "backfill-user-name",
    "precheck": [
      {
        "description": "Check for data transform: User.name",
        "source": {
          "collection": "users",
          "command": {
            "kind": "rawAggregate",
            "collection": "users",
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$in": [
                      {
                        "$type": "$name"
                      },
                      [
                        "missing",
                        "null"
                      ]
                    ]
                  }
                }
              },
              {
                "$limit": 1
              }
            ]
          },
          "meta": {
            "target": "mongo",
            "storageHash": "",
            "lane": "mongo-raw"
          }
        },
        "filter": {
          "kind": "exists",
          "field": "_id",
          "exists": true
        },
        "expect": "exists"
      }
    ],
    "run": [
      {
        "collection": "users",
        "command": {
          "kind": "rawUpdateMany",
          "collection": "users",
          "filter": {
            "$expr": {
              "$in": [
                {
                  "$type": "$name"
                },
                [
                  "missing",
                  "null"
                ]
              ]
            }
          },
          "update": {
            "$set": {
              "name": "unnamed"
            }
          },
          "bypassDocumentValidation": true
        },
        "meta": {
          "target": "mongo",
          "storageHash": "",
          "lane": "mongo-raw"
        }
      }
    ],
    "postcheck": [
      {
        "description": "Check for data transform: User.name",
        "source": {
          "collection": "users",
          "command": {
            "kind": "rawAggregate",
            "collection": "users",
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$in": [
                      {
                        "$type": "$name"
                      },
                      [
                        "missing",
                        "null"
                      ]
                    ]
                  }
                }
              },
              {
                "$limit": 1
              }
            ]
          },
          "meta": {
            "target": "mongo",
            "storageHash": "",
            "lane": "mongo-raw"
          }
        },
        "filter": {
          "kind": "exists",
          "field": "_id",
          "exists": true
        },
        "expect": "notExists"
      }
    ]
  },
  {
    "id": "validator.users.update",
    "label": "Update validator on users (added: name)",
    "operationClass": "widening",
    "precheck": [
      {
        "description": "collection users exists",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "users"
        },
        "expect": "exists",
        "object": "collection \"users\""
      },
      {
        "description": "every document in users fits the new validator",
        "source": {
          "collection": "users",
          "command": {
            "kind": "rawAggregate",
            "collection": "users",
            "pipeline": [
              {
                "$match": {
                  "$nor": [
                    {
                      "$jsonSchema": {
                        "additionalProperties": false,
                        "bsonType": "object",
                        "properties": {
                          "_id": {
                            "bsonType": "objectId"
                          },
                          "email": {
                            "bsonType": "string"
                          },
                          "name": {
                            "bsonType": "string"
                          },
                          "role": {
                            "bsonType": "string",
                            "enum": [
                              "USER",
                              "ADMIN"
                            ]
                          }
                        },
                        "required": [
                          "_id",
                          "email",
                          "name",
                          "role"
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "$limit": 1
              }
            ]
          },
          "meta": {
            "target": "mongo",
            "storageHash": "",
            "lane": "mongo-raw"
          }
        },
        "filter": {
          "kind": "exists",
          "field": "_id",
          "exists": true
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "modify users",
        "command": {
          "kind": "collMod",
          "collection": "users",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "email": {
                  "bsonType": "string"
                },
                "name": {
                  "bsonType": "string"
                },
                "role": {
                  "bsonType": "string",
                  "enum": [
                    "USER",
                    "ADMIN"
                  ]
                }
              },
              "required": [
                "_id",
                "email",
                "name",
                "role"
              ]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": [
      {
        "description": "validator applied on users",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "name",
              "op": "$eq",
              "value": "users"
            },
            {
              "kind": "field",
              "field": "options.validationLevel",
              "op": "$eq",
              "value": "strict"
            },
            {
              "kind": "field",
              "field": "options.validationAction",
              "op": "$eq",
              "value": "error"
            },
            {
              "kind": "field",
              "field": "options.validator.$jsonSchema",
              "op": "$eq",
              "value": {
                "additionalProperties": false,
                "bsonType": "object",
                "properties": {
                  "_id": {
                    "bsonType": "objectId"
                  },
                  "email": {
                    "bsonType": "string"
                  },
                  "name": {
                    "bsonType": "string"
                  },
                  "role": {
                    "bsonType": "string",
                    "enum": [
                      "USER",
                      "ADMIN"
                    ]
                  }
                },
                "required": [
                  "_id",
                  "email",
                  "name",
                  "role"
                ]
              }
            }
          ]
        },
        "expect": "exists"
      }
    ]
  }
]