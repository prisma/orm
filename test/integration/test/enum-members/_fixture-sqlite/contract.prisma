// use prisma-8

enum TextLevel {
  @@type("sqlite/text@1")
  Low  = "low"
  High = "high"
}

enum BigLevel {
  @@type("sqlite/bigint@1")
  Low  = "1"
  High = "10"
}

enum WhenLevel {
  @@type("sqlite/datetime@1")
  Launch = "2024-01-01T00:00:00.000Z"
  Sunset = "2025-06-30T12:00:00.000Z"
}

enum RealLevel {
  @@type("sqlite/real@1")
  Half     = 1.5
  Infinite = "Infinity"
}

model Reading {
  id   Int       @id
  text TextLevel
  big  BigLevel
  when WhenLevel
  real RealLevel

  @@map("readings")
}
