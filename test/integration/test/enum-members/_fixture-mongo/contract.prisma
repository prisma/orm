// use prisma-8

enum TextLevel {
  @@type("mongo/string@1")
  Low  = "low"
  High = "high"
}

enum Int32Level {
  @@type("mongo/int32@1")
  Low  = 1
  High = 10
}

enum DoubleLevel {
  @@type("mongo/double@1")
  Half  = 1.5
  Whole = 2.25
}

model Reading {
  id     ObjectId    @id @map("_id")
  text   TextLevel
  int32  Int32Level
  double DoubleLevel

  @@map("readings")
}
