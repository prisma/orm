// use prisma-8

// Emitted fixture for a polymorphic model with a relation to its own hierarchy.
//
//   Task (base, table `tasks`, discriminator `type`)
//     Bug     — single-table inheritance (own field `severity`)
//     Feature — multi-table inheritance (`@@map("features")`, field `priority`)
//
//   Task --subtasks(1:N)--> Task, Task --parent(N:1)--> Task
//   Feature --blockedBy(N:1)--> Task, declared on the variant table

model Task {
  id       Int    @id
  title    String
  type     String
  parentId Int?   @map("parent_id")

  parent   Task?  @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[] @relation("Subtasks")

  @@discriminator(type)
  @@map("tasks")
}

model Bug {
  severity String

  @@base(Task, "bug")
}

model Feature {
  priority    Int
  blockedById Int? @map("blocked_by_id")

  blockedBy Task? @relation(fields: [blockedById], references: [id])

  @@base(Task, "feature")
  @@map("features")
}
