// use prisma-8

// Real emitted fixture for the SQLite integer-representation type round-trip.
//
// `Meter.peak` and `Sample.reading` use bare `BigIntNumber` —
// `sqlite/bigintnumber@1`: INTEGER storage decoded as a JS number, throwing
// outside ±(2^53 − 1). `Sample.reading` sits on the child side of a relation so
// an include read traverses the codec's JSON-number projection through the
// nested-document path. SQLite declares no `UnboundedInt` type because it has
// no lossless unbounded integer storage, so this fixture exercises only the
// number-representation type.

model Meter {
  id   Int @id
  peak BigIntNumber

  samples Sample[]

  @@map("int_repr_meters")
}

model Sample {
  id      Int @id
  meterId Int @map("meter_id")
  reading BigIntNumber

  meter Meter @relation(fields: [meterId], references: [id])

  @@map("int_repr_samples")
}
