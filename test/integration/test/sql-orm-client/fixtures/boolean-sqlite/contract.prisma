// use prisma-8

// Real emitted fixture for SQLite's Boolean fields.

model Account {
  id     Int      @id
  active Boolean  @default(true)
  admin  Boolean?

  memberships Membership[]

  @@map("account")
}

model Membership {
  id        Int     @id
  accountId Int     @map("account_id")
  owner     Boolean

  account Account @relation(fields: [accountId], references: [id])

  @@map("membership")
}
