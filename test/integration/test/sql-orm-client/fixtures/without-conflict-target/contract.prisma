// use prisma-8

// Real emitted fixture for a contract that does not require `sql.insertOnConflictTarget`: its config leaves that key out of the required capabilities (see prisma.config.ts). Its users table matches the collection tests' schema.

model User {
  id          Int    @id
  name        String
  email       String @unique
  invitedById Int?   @map("invited_by_id")
  address     Json?

  @@map("users")
}
