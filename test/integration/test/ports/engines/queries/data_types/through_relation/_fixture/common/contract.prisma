// use prisma-8

model Parent {
  id Int @id
  children Child[]
  @@map("parent")
}
model Child {
  childId Int @id
  parentId Int?
  parent Parent? @relation(fields: [parentId], references: [id])
  string String
  int Int
  bInt BigInt
  float Float
  bytes Bytes
  bool Boolean
  dt DateTime
  @@map("child")
}
