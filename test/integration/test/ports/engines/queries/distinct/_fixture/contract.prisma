model User {
  id         Int      @id
  first_name String
  last_name  String
  email      String   @unique
  birthday   DateTime?
  posts      Post[]
  @@map("user")
}

model Post {
  id        Int    @id
  title     String
  content   String @default("Wip")
  author_id Int
  author    User   @relation(fields: [author_id], references: [id])
  @@map("post")
}
