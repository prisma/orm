model User {
  id               Int               @id @default(autoincrement())
  votes            Vote[]
  userToObjectives UserToObjective[]
  @@map("user")
}

model Objective {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  userToObjectives UserToObjective[] @relation("UserObjectives")
  @@map("objective")
}

model UserToObjective {
  userId      Int
  objectiveId Int
  user        User      @relation(fields: [userId], references: [id])
  objective   Objective @relation("UserObjectives", fields: [objectiveId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  votes       Vote[]

  @@id([userId, objectiveId])
  @@map("userToObjective")
}

model Vote {
  userId      Int
  objectiveId Int
  followerId  Int
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])
  userObjective UserToObjective @relation(fields: [objectiveId, followerId], references: [userId, objectiveId], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, objectiveId])
  @@map("vote")
}
