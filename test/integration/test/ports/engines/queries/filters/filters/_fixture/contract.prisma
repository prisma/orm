// use prisma-8

// Upstream uses generated CUID ids. The port seeds every incidental id explicitly so the fields retain String storage.

model User {
  id        String   @id
  unique    Int      @unique
  name      String?
  optional  String?
  vehicle_id String?  @unique
  ride       Vehicle? @relation(fields: [vehicle_id], references: [id])
  @@map("user")
}

model Vehicle {
  id     String  @id
  unique Int     @unique
  brand  String?
  parked Boolean?
  owner  User?
  @@map("vehicle")
}

model ParkingLot {
  id       String @id
  unique   Int    @unique
  area     String?
  size     Float?
  capacity Int?
  @@map("parkingLot")
}
