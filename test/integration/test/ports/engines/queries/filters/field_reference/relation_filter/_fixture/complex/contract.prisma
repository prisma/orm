model TestModel {
  id     Int         @id
  toMany OneToMany[]
  @@map("testModel")
}

model OneToMany {
  id      Int        @id
  testId  Int?
  test    TestModel? @relation(fields: [testId], references: [id])
  toOneId Int?       @unique
  toOne   ToOne?     @relation(fields: [toOneId], references: [id])
  @@map("oneToMany")
}

model ToOne {
  id      Int        @id
  string1 String
  string2 String
  toMany  OneToMany?
  @@map("toOne")
}
