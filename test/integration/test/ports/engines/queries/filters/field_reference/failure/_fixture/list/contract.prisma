model TestModel {
  id       Int      @id
  str      String
  str_list String[]
  children Child[]
  @@map("testModel")
}

model Child {
  id       Int       @id
  str      String
  str_list String[]
  testId   Int
  test     TestModel @relation(fields: [testId], references: [id])
  @@map("child")
}
