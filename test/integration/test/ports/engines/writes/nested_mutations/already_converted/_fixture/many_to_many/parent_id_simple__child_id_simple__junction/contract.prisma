// use prisma-8

model Parent {
  p           String  @unique
  p_1         String
  p_2         String
  childrenOpt Child[]
  non_unique  String?
  id          String  @id @default(cuid(2))

  @@unique([p_1, p_2])
  @@map("Parent")
}

model Child {
  c          String   @unique
  c_1        String
  c_2        String
  parentsOpt Parent[]
  non_unique String?
  id         String   @id @default(cuid(2))

  @@unique([c_1, c_2])
  @@map("Child")
}

model ChildToParent {
  childId  String @map("A")
  parentId String @map("B")
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([childId, parentId])
  @@map("_ChildToParent")
}
