// use prisma-8

model Parent {
  p          String  @unique
  p_1        String
  p_2        String
  childOpt   Child?
  non_unique String?

  @@unique([p_1, p_2])
  @@map("Parent")
}

model Child {
  c          String  @unique
  c_1        String
  c_2        String
  parentOpt  Parent? @relation(fields: [parent_p_1, parent_p_2], references: [p_1, p_2])
  parent_p_1 String?
  parent_p_2 String?
  non_unique String?

  @@unique([parent_p_1, parent_p_2])
  @@unique([c_1, c_2])
  @@map("Child")
}
