// use prisma-8

model Parent {
  p           String  @unique
  p_1         String
  p_2         String
  childrenOpt Child[]
  non_unique  String?
  id_1        String  @default(cuid(2))
  id_2        String  @default(cuid(2))

  @@id([id_1, id_2])
  @@unique([p_1, p_2])
  @@map("Parent")
}

model Child {
  c          String  @unique
  c_1        String
  c_2        String
  parentReq  Parent  @relation(fields: [parentRef], references: [p])
  parentRef  String
  non_unique String?

  @@unique([c_1, c_2])
  @@map("Child")
}
