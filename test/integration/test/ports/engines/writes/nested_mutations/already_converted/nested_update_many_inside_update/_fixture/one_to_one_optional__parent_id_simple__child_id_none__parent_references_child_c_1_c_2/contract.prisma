// use prisma-8

model Parent {
  p          String  @unique
  p_1        String
  p_2        String
  childOpt   Child?  @relation(fields: [child_c_1, child_c_2], references: [c_1, c_2])
  child_c_1  String?
  child_c_2  String?
  non_unique String?
  id         String  @id @default(cuid(2))

  @@unique([child_c_1, child_c_2])
  @@unique([p_1, p_2])
  @@map("Parent")
}

model Child {
  c          String  @unique
  c_1        String
  c_2        String
  parentOpt  Parent?
  non_unique String?

  @@unique([c_1, c_2])
  @@map("Child")
}
