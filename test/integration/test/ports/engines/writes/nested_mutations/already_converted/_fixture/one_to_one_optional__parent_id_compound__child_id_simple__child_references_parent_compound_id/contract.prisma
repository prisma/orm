// use prisma-8

model Parent {
  p          String  @unique
  p_1        String
  p_2        String
  childOpt   Child?
  non_unique String?
  id_1       String  @default(cuid(2))
  id_2       String  @default(cuid(2))

  @@id([id_1, id_2])
  @@unique([p_1, p_2])
  @@map("Parent")
}

model Child {
  c           String  @unique
  c_1         String
  c_2         String
  parentOpt   Parent? @relation(fields: [parent_id_1, parent_id_2], references: [id_1, id_2])
  parent_id_1 String?
  parent_id_2 String?
  non_unique  String?
  id          String  @id @default(cuid(2))

  @@unique([parent_id_1, parent_id_2])
  @@unique([c_1, c_2])
  @@map("Child")
}
