// use prisma-8

model Parent {
  p          String  @unique
  p_1        String
  p_2        String
  childOpt   Child?  @relation(fields: [childId], references: [id])
  childId    String?
  non_unique String?
  id         String  @id @default(cuid(2))

  @@unique([childId])
  @@unique([p_1, p_2])
  @@map("Parent")
}

model Child {
  c          String  @unique
  c_1        String
  c_2        String
  parentOpt  Parent?
  non_unique String?
  id         String  @id @default(cuid(2))

  @@unique([c_1, c_2])
  @@map("Child")
}
