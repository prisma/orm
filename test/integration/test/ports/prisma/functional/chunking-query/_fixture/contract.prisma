// Faithful translation of prisma/prisma functional suite `chunking-query`
// (packages/client/tests/functional/chunking-query, postgres matrix entry).
//
// Upstream schema (postgres branch):
//   model Post {
//     id   Int           @id
//     tags TagsOnPosts[]
//     @@map("post")
//   }
//   model Tag {
//     id    Int           @id
//     posts TagsOnPosts[]
//     @@map("tag")
//   }
//   model TagsOnPosts {
//     postId Int
//     tagId  Int
//     post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
//     tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
//     @@id([postId, tagId])
//   }
model Post {
  id   Int           @id
  tags TagsOnPosts[]

  @@map("post")
}

model Tag {
  id    Int           @id
  posts TagsOnPosts[]

  @@map("tag")
}

model TagsOnPosts {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("tagsOnPosts")
}
