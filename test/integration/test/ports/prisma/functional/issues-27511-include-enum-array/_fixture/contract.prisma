// use prisma-8

// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/27511-include-enum-array (postgres only).
//
// Upstream schema (postgres):
//   enum workspace_permission { HELLO WORLD }
//   model workspace_member { id String @id @default(cuid()) @db.VarChar(30); roles workspace_role[] }
//   model workspace_role { id String @id @default(cuid()) @db.VarChar(30); name String;
//     permissions workspace_permission[]; members workspace_member[] }
//
// Prisma 8: text-backed enum; implicit M2M requires explicit junction model.
// The enum-array column (permissions workspace_permission[]) hits the same
// emitter gap as enum-array (text-backed enum list emits CHECK instead of valid
// Postgres array CHECK) — the contract push fails before any ORM query runs.

enum workspace_permission {
  @@type("pg/text@1")
  HELLO = "HELLO"
  WORLD = "WORLD"
}

model workspace_member {
  id    VarChar(30)               @id
  roles workspace_member_role[]
  @@map("workspace_member")
}

model workspace_role {
  id          VarChar(30)               @id
  name        String
  permissions workspace_permission[]
  members     workspace_member_role[]
  @@map("workspace_role")
}

model workspace_member_role {
  memberId String
  roleId   String
  member   workspace_member @relation(fields: [memberId], references: [id])
  role     workspace_role   @relation(fields: [roleId], references: [id])

  @@id([memberId, roleId])
  @@map("workspace_member_role")
}
