// use prisma-8

// Faithful MongoDB translation of prisma/prisma@a6d0155
// packages/client/tests/functional/0-legacy-ports/aggregate-raw/prisma/_schema.ts.

model User {
  id    ObjectId @id @map("_id")
  email String   @unique
  age   Int32
  name  String?
  posts Post[]

  @@map("User")
}

model Post {
  id        ObjectId @id @map("_id")
  createdAt Date
  updatedAt Date
  published Bool
  title     String
  content   String?
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])

  @@map("Post")
}
