// use prisma-8

// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/29331-query-plan-cache-bloat
// (postgres matrix entry; allProviders — we port postgres).
//
// Upstream schema (postgres branch):
//   idForProvider(postgresql, { includeDefault: true }) → String @id @default(cuid(2))
//   model Contact {
//     id        String  @id @default(cuid())
//     analytics ContactAnalytics[]
//   }
//   model ContactAnalytics { ... many nullable DateTime/Int/Float/Boolean fields ... }

model Contact {
  id        String             @id @default(cuid(2))
  analytics ContactAnalytics[]
  @@map("contact")
}

model ContactAnalytics {
  id        String   @id @default(cuid(2))
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  date1     DateTime?
  date2     DateTime?
  date3     DateTime?
  date4     DateTime?
  date5     DateTime?
  date6     DateTime?
  date7     DateTime?
  val1      Int?
  val2      Int?
  val3      Int?
  val4      Int?
  val5      Int?
  float1    Float?
  float2    Float?
  bool1     Boolean?
  bool2     Boolean?
  bool3     Boolean?
  @@map("contactAnalytics")
}
