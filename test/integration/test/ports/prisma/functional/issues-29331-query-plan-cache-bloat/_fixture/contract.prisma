// use prisma-8

// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/29331-query-plan-cache-bloat
// (postgres matrix entry; allProviders — we port postgres).
//
// Upstream schema (postgres branch):
//   idForProvider(postgresql, { includeDefault: true }) → String @id @default(cuid(2))
//   model Contact {
//     id        String  @id @default(cuid())
//     analytics ContactAnalytics[]
//   }
//   model ContactAnalytics { ... many nullable DateTime/Int/Float/Boolean fields ... }

model Contact {
  id        String             @id @onCreate(cuid(2))
  analytics ContactAnalytics[]
  @@map("contact")
}

model ContactAnalytics {
  id        String   @id @onCreate(cuid(2))
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  date1     TimestamptzTemporal?
  date2     TimestamptzTemporal?
  date3     TimestamptzTemporal?
  date4     TimestamptzTemporal?
  date5     TimestamptzTemporal?
  date6     TimestamptzTemporal?
  date7     TimestamptzTemporal?
  val1      Int?
  val2      Int?
  val3      Int?
  val4      Int?
  val5      Int?
  float1    Float?
  float2    Float?
  bool1     Boolean?
  bool2     Boolean?
  bool3     Boolean?
  @@map("contactAnalytics")
}
