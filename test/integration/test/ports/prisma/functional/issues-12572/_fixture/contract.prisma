// use prisma-8

// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/12572 (postgres matrix entry).
//
// Upstream schema:
//   model User {
//     id        String   @id @default(cuid())
//     createdAt DateTime @default(now())
//     updatedAt DateTime @updatedAt
//   }
//
// Prisma 8: @updatedAt maps to temporal.UpdatedAt.

model User {
  id        String   @id @onCreate(cuid(2))
  createdAt DateTime @default(now())
  updatedAt temporal.UpdatedAt
  @@map("user")
}
