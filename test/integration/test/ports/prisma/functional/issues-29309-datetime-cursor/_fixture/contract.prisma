// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/29309-datetime-cursor
// (postgres matrix entry; sqlProviders minus sqlite — we port postgres).
//
// Upstream: DateTime @db.Date → postgres `date` column.
// In prisma-next PSL, the native Date type pins codec pg/date-temporal@1.
//
// Upstream schema (postgres branch):
//   model Event {
//     appId     Int
//     createdAt DateTime @db.Date
//     value     Int
//     @@id([appId, createdAt])
//   }

model Event {
  appId     Int
  createdAt Date
  value     Int

  @@id([appId, createdAt])
}
