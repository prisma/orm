// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/28591-mapped-enums (postgres only).
//
// Upstream schema:
//
//   enum SuggestionStatus {
//     PENDING  @map("pending")
//     ACCEPTED @map("accepted")
//     REJECTED @map("rejected")
//     @@map("SuggestionStatus")
//   }
//   model SuggestionModel {
//     id               Int              @id @default(autoincrement())
//     suggestedContent String           @map("suggested_content")
//     status           SuggestionStatus @default(PENDING)
//     @@index([status])
//     @@map("snippet_suggestions")
//   }
//
// Subject: creating a record with a @map'd enum value works (enum member names differ
// from their DB-level values).
//
// In Prisma 8 PSL, native_enum member values (right-hand side of =) are the PG
// enum labels stored in the database. The faithful translation uses the mapped
// (lowercase) values so the DB schema matches the upstream schema exactly.
//
// NOTE: Prisma 8's pg/enum@1 codec returns the PG label verbatim, so a read
// of status after creating with "pending" returns "pending", not "PENDING". The
// upstream test asserts `status === 'PENDING'` (the TS enum name). This is the
// faithfully-ported but failing test — marked it.fails in the test file.
native_enum SuggestionStatus {
  PENDING  = "pending"
  ACCEPTED = "accepted"
  REJECTED = "rejected"
  @@map("SuggestionStatus")
}

model SuggestionModel {
  id               Int              @id @default(autoincrement())
  suggestedContent String           @map("suggested_content")
  status           pg.enum(SuggestionStatus) @default(dbgenerated("'pending'::\"SuggestionStatus\""))

  @@index([status])
  @@map("snippet_suggestions")
}
