model User {
  id    BigInt  @id
  name  String
  posts Post[]
  @@map("user")
}

model Post {
  id       BigInt  @id
  title    String
  authorId BigInt
  author   User    @relation(fields: [authorId], references: [id])
  @@map("post")
}
