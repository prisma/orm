// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/28192-pg-historical-dates (postgres only).
//
// Upstream schema:
//
//   model TestData {
//     id          String   @id @default(uuid())
//     date        DateTime @db.Date
//     timestamp   DateTime @db.Timestamp
//     timestamptz DateTime @db.Timestamptz
//   }
//
// Subject: postgres timestamps with historical/2-digit-year dates (years 00-99 AD)
// round-trip correctly.
// Note: @db.Date/@db.Timestamp/@db.Timestamptz are authored as type-position
// types in Prisma 8 PSL.
model TestData {
  id          String     @id @default(cuid(2))
  date        Date
  timestamp   Timestamp
  timestamptz Timestamptz
  @@map("testData")
}
