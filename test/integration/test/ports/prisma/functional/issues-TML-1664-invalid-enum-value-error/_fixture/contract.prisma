// use prisma-8

// Faithful translation of prisma/prisma@a6d0155
// packages/client/tests/functional/issues/TML-1664-invalid-enum-value-error (postgres only).
//
// Upstream schema (postgres):
//   model User { id String @id; status Status }
//   enum Status { ACTIVE INACTIVE PENDING }
//
// Prisma 8: native PG ENUM uses native_enum block + pg.enum() column type.
// The test manipulates the DB enum after schema push to create a mismatch.

native_enum Status {
  ACTIVE  = "ACTIVE"
  INACTIVE = "INACTIVE"
  PENDING  = "PENDING"
}

model User {
  id     String         @id
  status pg.enum(Status)
  @@map("user")
}
