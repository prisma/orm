// use prisma-8

model Clock {
  id                 Int    @id
  label              String
  date               DateTemporal @onCreate(now()) @onUpdate(now())
  dateString         DateString @onCreate(now()) @onUpdate(now())
  time0              TimeTemporal(0) @onCreate(now()) @onUpdate(now())
  time3              TimeTemporal(3) @onCreate(now()) @onUpdate(now())
  time6              TimeTemporal(6) @onCreate(now()) @onUpdate(now())
  timeString0        TimeString(0) @onCreate(now()) @onUpdate(now())
  timeString3        TimeString(3) @onCreate(now()) @onUpdate(now())
  timeString6        TimeString(6) @onCreate(now()) @onUpdate(now())
  timetz0            Timetz(0) @onCreate(now()) @onUpdate(now())
  timetz3            Timetz(3) @onCreate(now()) @onUpdate(now())
  timetz6            Timetz(6) @onCreate(now()) @onUpdate(now())
  timestamp0         TimestampTemporal(0) @onCreate(now()) @onUpdate(now())
  timestamp1         TimestampTemporal(1) @onCreate(now()) @onUpdate(now())
  timestamp3         TimestampTemporal(3) @onCreate(now()) @onUpdate(now())
  timestamp6         TimestampTemporal(6) @onCreate(now()) @onUpdate(now())
  timestampString0   TimestampString(0) @onCreate(now()) @onUpdate(now())
  timestampString3   TimestampString(3) @onCreate(now()) @onUpdate(now())
  timestampString6   TimestampString(6) @onCreate(now()) @onUpdate(now())
  timestamptz0       TimestamptzTemporal(0) @onCreate(now()) @onUpdate(now())
  timestamptz2       TimestamptzTemporal(2) @onCreate(now()) @onUpdate(now())
  timestamptz3       TimestamptzTemporal(3) @onCreate(now()) @onUpdate(now())
  timestamptz6       TimestamptzTemporal(6) @onCreate(now()) @onUpdate(now())
  timestamptzString0 TimestamptzString(0) @onCreate(now()) @onUpdate(now())
  timestamptzString1 TimestamptzString(1) @onCreate(now()) @onUpdate(now())
  timestamptzString2 TimestamptzString(2) @onCreate(now()) @onUpdate(now())
  timestamptzString3 TimestamptzString(3) @onCreate(now()) @onUpdate(now())
  timestamptzString6 TimestamptzString(6) @onCreate(now()) @onUpdate(now())
  timestamptzJsDate0 TimestamptzJsDate(0) @onCreate(now()) @onUpdate(now())
  timestamptzJsDate1 TimestamptzJsDate(1) @onCreate(now()) @onUpdate(now())
  timestamptzJsDate2 TimestamptzJsDate(2) @onCreate(now()) @onUpdate(now())
  timestamptzJsDate3 TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  timestamptzJsDate6 TimestamptzJsDate(6) @onCreate(now()) @onUpdate(now())
  timestampJsDate0   TimestampJsDate(0) @onCreate(now()) @onUpdate(now())
  timestampJsDate1   TimestampJsDate(1) @onCreate(now()) @onUpdate(now())
  timestampJsDate2   TimestampJsDate(2) @onCreate(now()) @onUpdate(now())
  timestampInstant0  TimestampInstant(0) @onCreate(now()) @onUpdate(now())
  timestampInstant2  TimestampInstant(2) @onCreate(now()) @onUpdate(now())
  dateTime0          DateTime(precision: 0) @onCreate(now()) @onUpdate(now())
  @@map("clock")
}
