// use prisma-8

model Event {
  id      Int          @id
  a       TimestamptzTemporal     @default("2024-01-01T00:00:00Z")
  b       TimestamptzTemporal     @default("2024-01-01T00:00:00.000Z")
  c       TimestamptzTemporal     @default("2024-01-01T01:00:00+01:00")
  localAt TimestampTemporal(3) @default("2024-01-01 12:34:56.500")
  day     DateTemporal         @default("2024-01-01")
  clock   TimeTemporal         @default("12:34")
  zoned   Timetz       @default("12:34:56+02")
  history TimestamptzTemporal[]   @default(["2024-01-01T00:00:00.000Z", "2024-06-30 12:34:56+00"])

  @@map("event")
}
