// use prisma-8

model User {
  id Int @id
  posts Post[]
  @@map("user")
}

model Post {
  id Int @id
  primaryUserId Int
  secondaryUserId Int
  primaryUser User @relation(fields: [primaryUserId], references: [id])
  secondaryUser User @relation(fields: [secondaryUserId], references: [id])
  @@map("post")
}
