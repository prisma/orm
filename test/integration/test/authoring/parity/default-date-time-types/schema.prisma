// use prisma-8

model T {
  id      Int       @id
  instant DateTime  @default("2024-01-01T01:00:00.500+01:00")
  local   Timestamp @default("2024-01-01 12:34:56.500")
  day     Date      @default("0044-03-15 BC")
  clock   Time      @default("12:34")
  zoned   Timetz    @default("12:34:56+02")
  big     BigInt    @default(9007199254740993)
  bytes   Bytes     @default("AQID")

  @@map("t")
}
