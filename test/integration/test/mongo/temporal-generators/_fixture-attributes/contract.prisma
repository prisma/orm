// use prisma-8

model Post {
  id        ObjectId             @id @map("_id")
  title     String
  createdAt Date                 @onCreate(now())
  updatedAt Date                 @onCreate(now()) @onUpdate(now()) @map("updated_at")
  touchedAt Date                 @onUpdate(now())

  @@map("posts")
}

model Counter {
  id        ObjectId             @id @map("_id")
  key       String
  tags      String[]
  scores    Int32[]
  factor    Double
  hits      Int32
  label     String?
  updatedAt Date                 @onCreate(now()) @onUpdate(now())

  @@map("counters")
}

model Event {
  id        ObjectId             @id @map("_id")
  kind      String
  createdAt Date                 @onCreate(now())

  @@discriminator(kind)
  @@map("events")
}

model Click {
  url String

  @@base(Event, "click")
}

model View {
  path String

  @@base(Event, "view")
}
