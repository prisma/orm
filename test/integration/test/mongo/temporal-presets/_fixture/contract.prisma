// use prisma-8

model Post {
  id        ObjectId             @id @map("_id")
  title     String
  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt() @map("updated_at")
  touchedAt temporal.timestamp(onUpdate: now)

  @@map("posts")
}

model Counter {
  id        ObjectId             @id @map("_id")
  key       String
  tags      String[]
  scores    Int32[]
  factor    Double
  hits      Int32
  label     String?
  updatedAt temporal.updatedAt()

  @@map("counters")
}

model Event {
  id        ObjectId             @id @map("_id")
  kind      String
  createdAt temporal.createdAt()

  @@discriminator(kind)
  @@map("events")
}

model Click {
  url String

  @@base(Event, "click")
}

model View {
  path String

  @@base(Event, "view")
}
