// use prisma-8

model Post {
  id        ObjectId   @id @map("_id")
  views     Int64
  price     Decimal128
  thumbnail Binary
  meta      Json
  notes     Json?
  raw       Bson?

  @@map("posts")
}

model Tally {
  id    ObjectId @id @map("_id")
  hits  Int32?
  ratio Double?

  @@map("tallies")
}

type Stamp {
  note Json
}

model Asset {
  id   ObjectId @id @map("_id")
  kind String

  @@discriminator(kind)
  @@map("assets")
}

model Photo {
  ownerId ObjectId
  exif    Json
  stamps  Stamp[]

  @@base(Asset, "photo")
}
