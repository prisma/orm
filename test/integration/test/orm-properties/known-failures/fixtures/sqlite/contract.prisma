// use prisma-8

model Counter {
  id  Int    @id
  big BigInt
}

model Person {
  id        Int  @id
  managerId Int?

  manager Person?  @relation("Management", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports Person[] @relation("Management")
}

model Project {
  id    Int    @id
  tasks Task[]
}

model Task {
  id        Int      @id
  title     String
  kind      String
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  @@discriminator(kind)
}

model Bug {
  severity String?

  @@base(Task, "bug")
}

model Chore {
  effort Int?

  @@base(Task, "chore")
}

model Feature {
  priority Int?

  @@base(Task, "feature")
  @@map("features")
}

model Label {
  id   Int         @id
  code sql.Char(5)
}
