    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/errors": "workspace:8.0.0-rc.21",
    "@internal/framework-components": "workspace:8.0.0-rc.21",
    "@internal/mongo-lowering": "workspace:8.0.0-rc.21",
    "@internal/mongo-wire": "workspace:8.0.0-rc.21",
    "@internal/utils": "workspace:8.0.0-rc.21"
  },
  "devDependencies": {
    "mongodb": "catalog:",
    "@repo/test-utils": "workspace:8.0.0-rc.21",
    "@repo/tsconfig": "workspace:8.0.0-rc.21",
    "@repo/tsdown": "workspace:8.0.0-rc.21",
    "mongodb-memory-server": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
