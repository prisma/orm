  "devDependencies": {
    "mongodb": "catalog:",
    "@internal/emitter": "workspace:8.0.0-rc.25",
    "@internal/mongo-codec": "workspace:8.0.0-rc.25",
    "@internal/mongo-emitter": "workspace:8.0.0-rc.25",
    "@internal/psl-parser": "workspace:8.0.0-rc.25",
    "@repo/test-utils": "workspace:8.0.0-rc.25",
