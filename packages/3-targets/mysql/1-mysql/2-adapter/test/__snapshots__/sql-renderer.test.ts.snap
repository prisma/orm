  "params": [],
  "sql": "SELECT /*+ SET_VAR(group_concat_max_len = 4294967295) */ CASE WHEN COUNT(*) = 0 THEN JSON_ARRAY() ELSE CAST(COALESCE(CONCAT('[', GROUP_CONCAT(JSON_OBJECT('id', \`rows\`.\`id\`, 'big', CAST(\`rows\`.\`big\` AS CHAR), 'at', \`rows\`.\`at\`, 'raw', \`rows\`.\`raw\`, 'posts', \`rows\`.\`posts\`) ORDER BY \`rows\`.\`order_0\` DESC SEPARATOR ','), ']'), CONCAT('array larger than max_allowed_packet: ', COUNT(*), ' rows')) AS JSON) END AS \`v\`",
}
`;

