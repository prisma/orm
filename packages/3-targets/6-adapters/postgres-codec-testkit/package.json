{
  "name": "@internal/postgres-codec-testkit",
  "private": true,
  "version": "8.0.0-rc.12",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Database-backed codec JSON-projection conformance harness for the PostgreSQL target, for extension authors to verify their own codec descriptors against a live database",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/adapter-postgres": "workspace:8.0.0-rc.12",
    "@internal/contract": "workspace:8.0.0-rc.12",
    "@internal/framework-components": "workspace:8.0.0-rc.12",
    "@internal/sql-contract": "workspace:8.0.0-rc.12",
    "@internal/sql-relational-core": "workspace:8.0.0-rc.12",
    "@internal/target-postgres": "workspace:8.0.0-rc.12",
    "@internal/utils": "workspace:8.0.0-rc.12"
  },
  "devDependencies": {
    "@internal/driver-postgres": "workspace:8.0.0-rc.12",
    "@internal/sql-errors": "workspace:8.0.0-rc.12",
    "@repo/test-utils": "workspace:8.0.0-rc.12",
    "@repo/tsconfig": "workspace:8.0.0-rc.12",
    "@repo/tsdown": "workspace:8.0.0-rc.12",
    "temporal-polyfill": "^1.0.4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/orm.git",
    "directory": "packages/3-targets/6-adapters/postgres-codec-testkit"
  }
}
