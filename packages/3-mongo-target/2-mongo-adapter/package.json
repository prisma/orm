{
  "name": "@internal/adapter-mongo",
  "private": true,
  "version": "8.0.0-rc.5",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "MongoDB adapter for Prisma Next (lowers commands to wire format)",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/config": "workspace:8.0.0-rc.5",
    "@internal/contract": "workspace:8.0.0-rc.5",
    "@internal/errors": "workspace:8.0.0-rc.5",
    "@internal/family-mongo": "workspace:8.0.0-rc.5",
    "@internal/framework-components": "workspace:8.0.0-rc.5",
    "@internal/migration-tools": "workspace:8.0.0-rc.5",
    "@internal/mongo-codec": "workspace:8.0.0-rc.5",
    "@internal/mongo-contract": "workspace:8.0.0-rc.5",
    "@internal/mongo-lowering": "workspace:8.0.0-rc.5",
    "@internal/mongo-query-ast": "workspace:8.0.0-rc.5",
    "@internal/mongo-query-builder": "workspace:8.0.0-rc.5",
    "@internal/mongo-schema-ir": "workspace:8.0.0-rc.5",
    "@internal/mongo-value": "workspace:8.0.0-rc.5",
    "@internal/mongo-wire": "workspace:8.0.0-rc.5",
    "@internal/operations": "workspace:8.0.0-rc.5",
    "@internal/utils": "workspace:8.0.0-rc.5",
    "arktype": "catalog:",
    "bson": "^7.3.1"
  },
  "devDependencies": {
    "mongodb": "catalog:",
    "@internal/driver-mongo": "workspace:8.0.0-rc.5",
    "@internal/errors": "workspace:8.0.0-rc.5",
    "@internal/mongo-contract-psl": "workspace:8.0.0-rc.5",
    "@internal/psl-parser": "workspace:8.0.0-rc.5",
    "@repo/test-utils": "workspace:8.0.0-rc.5",
    "@repo/tsconfig": "workspace:8.0.0-rc.5",
    "@repo/tsdown": "workspace:8.0.0-rc.5",
    "mongodb-memory-server": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "mongodb": "^7.0.0",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./codec-ids": "./dist/codec-ids.mjs",
    "./codec-types": "./dist/codec-types.mjs",
    "./codecs": "./dist/codecs.mjs",
    "./control": "./dist/control.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/3-mongo-target/2-mongo-adapter"
  }
}
