n6 State users <- state n5
n7 FindByKeys users by (id) for create <- Rows n5, state n6
n8 State posts
n9 Insert posts <- PayloadData n7 (id->user_id), state n8
n10 State posts <- state n9
n11 State tags
n12 Insert tags <- state n11
n13 State tags <- state n12
n14 FindByKeys tags by (id) for create <- Rows n12, state n13
n15 State user_tags
n16 Insert user_tags <- PayloadData n7 (id->user_id), PayloadData n14 (id->tag_id), state n15
n17 State user_tags <- state n16
n18 Find users <- FilterData n7 (id->id), state n6, state n10
result: n18"
`;

