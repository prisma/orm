n3 State users <- state n2
result: n2"
`;

exports[`state edges of the graphs builders build, with returning > updateFirstGraph with relation operations 1`] = `
"n1 State users
n2 Find users where name = 'Ada' limit 1 <- state n1
n3 Find users where id = 2 limit 1 <- state n1, Requires n2
n4 Assert <- Rows n3, Requires n2
n5 Update users set name = 'Grace' <- FilterData n2 (id->id), PayloadData n3 (id->invited_by_id), state n1
n6 State users <- state n5
n7 State posts
n8 Insert posts <- PayloadData n5 (id->user_id), state n7
n9 State posts <- state n8
n10 State tags
n11 Find tags where id = 5 limit 1 <- state n10, Requires n2
n12 Assert <- Rows n11, Requires n2
n13 State user_tags
n14 Insert user_tags on conflict (user_id, tag_id) do nothing <- PayloadData n5 (id->user_id), PayloadData n11 (id->tag_id), state n13
n15 State user_tags <- state n14
n16 Find users <- FilterData n5 (id->id), state n6, state n9
result: n16"
`;

exports[`state edges of the graphs builders build, with returning > upsertGraph 1`] = `
"n1 State users
n2 Insert users on conflict (email) do update <- state n1
n3 State users <- state n2
result: n2"
`;

