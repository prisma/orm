// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`state edges of the graph createAllVariantGraph builds > createAllVariantGraph 1`] = `
"n1 State tasks
n2 Insert tasks <- state n1
n3 State tasks <- state n2
n4 State features
n5 Insert features <- PayloadData n2 (id->id), state n4
n6 State features <- state n5
n7 CrossJoin <- Rows n2, Rows n5
n8 Insert tasks <- state n3
n9 State tasks <- state n8
n10 Insert features <- PayloadData n8 (id->id), state n6
n11 State features <- state n10
n12 CrossJoin <- Rows n8, Rows n10
n13 UnionAll <- Rows n7, Rows n12
result: n13"
`;

exports[`state edges of the graphs builders build, with returning > createAllGraph 1`] = `
"n1 State users
n2 Insert users <- state n1
n3 State users <- state n2
n4 State posts
n5 Find users <- FilterData n2 (id->id), state n3, state n4
result: n5"
`;

exports[`state edges of the graphs builders build, with returning > createGraph with relation operations 1`] = `
"n1 State users
n2 Insert users <- state n1
n3 State users <- state n2
n4 Insert users <- PayloadData n2 (id->invited_by_id), state n3
n5 State users <- state n4
n6 State posts
n7 Insert posts <- PayloadData n4 (id->user_id), state n6
n8 State posts <- state n7
n9 State tags
n10 Insert tags <- state n9
n11 State tags <- state n10
n12 State user_tags
n13 Insert user_tags <- PayloadData n4 (id->user_id), PayloadData n10 (id->tag_id), state n12
n14 State user_tags <- state n13
n15 Find users <- FilterData n4 (id->id), state n5, state n8
result: n15"
`;

exports[`state edges of the graphs builders build, with returning > deleteAllGraph 1`] = `
"n1 State users
n2 State posts
n3 Find users where name = 'Ada' <- state n1, state n2
n4 Delete users where name = 'Ada' <- state n1
n5 State users <- state n4
result: n3"
`;

