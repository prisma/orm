    "prisma-orm-extension"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check . --error-on-warnings",
    "clean": "rm -rf dist src-gen"
  },
  "dependencies": {
    "@prisma/orm-family-sql": "workspace:8.0.0-rc.22",
    "@prisma/orm-framework": "workspace:8.0.0-rc.22",
    "@prisma/orm-toolchain": "workspace:8.0.0-rc.22"
  },
  "devDependencies": {
    "@internal/extension-citext": "workspace:8.0.0-rc.22",
    "@repo/tsconfig": "workspace:8.0.0-rc.22",
    "@repo/tsdown": "workspace:8.0.0-rc.22",
    "@prisma/orm-target-postgres": "workspace:8.0.0-rc.22",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@prisma/orm-target-postgres": "workspace:8.0.0-rc.22",
