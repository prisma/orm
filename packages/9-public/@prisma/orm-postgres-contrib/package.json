{
  "name": "@prisma/orm-postgres-contrib",
  "version": "8.0.0-rc.22",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Packs for the trusted PostgreSQL contrib modules, such as citext, for Prisma 8",
