datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  posts   Post[]
  profile Profile?
  account Account
}

model Post {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  title String
}

model Profile {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  user User
}

model Account {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}
