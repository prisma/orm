datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  posts     Post[]
  comments  Comment[]
  likes     Like[]
  reactions Reaction[]
}

model Post {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

model Comment {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  authorId String? @db.ObjectId
  author   User?   @relation(fields: [authorId], references: [id], onUpdate: Cascade, onDelete: SetNull)
}

model Like {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], map: "Like_userId_fkey")
}

model Reaction {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
