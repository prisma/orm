datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  touchedAt DateTime @default(now())

  @@map("people")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  touchedAt DateTime @updatedAt

  @@map("people")
}
