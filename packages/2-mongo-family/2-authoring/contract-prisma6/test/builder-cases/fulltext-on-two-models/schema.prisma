datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  @@fulltext([name])
  @@map("people")
}

model Admin {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  @@fulltext([name])
  @@map("people")
}
