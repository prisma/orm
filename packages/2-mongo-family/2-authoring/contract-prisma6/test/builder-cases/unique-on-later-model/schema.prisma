datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  email String
  name  String

  @@index([email])
  @@index([name])
  @@map("people")
}

model Admin {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique

  @@map("people")
}
