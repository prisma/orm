// use prisma-8

model User {
  id    ObjectId @id @map("_id")
  posts Post[]
}

model Post {
  id        ObjectId               @id @map("_id")
  title     String
  views     BigInt
  likes     BigInt(as: number)
  rank      Int32
  note      String
  pinned    Bool
  score     Double
  day       DateTime
  blob      Binary
  legacyRef ObjectId
  total     Int64BigInt
  extra     Json
  meta      Json
  authorId  ObjectId
  author    User                   @relation(fields: [authorId], references: [id])
  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt

  @@index([authorId], map: "Post_authorId_idx")
}
