    "@internal/framework-components": "workspace:8.0.0-rc.17",
    "@internal/mongo-contract": "workspace:8.0.0-rc.17",
    "@internal/mongo-contract-psl": "workspace:8.0.0-rc.17",
    "@internal/psl-parser": "workspace:8.0.0-rc.17",
    "@internal/utils": "workspace:8.0.0-rc.17",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@internal/adapter-mongo": "workspace:8.0.0-rc.17",
