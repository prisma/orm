{
  "name": "@internal/mongo-contract-ts",
  "private": true,
  "version": "8.0.0-rc.11",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Mongo-specific TypeScript contract authoring surface for Prisma 8",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/config": "workspace:8.0.0-rc.11",
    "@internal/contract": "workspace:8.0.0-rc.11",
    "@internal/contract-authoring": "workspace:8.0.0-rc.11",
    "@internal/errors": "workspace:8.0.0-rc.11",
    "@internal/framework-components": "workspace:8.0.0-rc.11",
    "@internal/mongo-contract": "workspace:8.0.0-rc.11",
    "@internal/utils": "workspace:8.0.0-rc.11",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@repo/test-utils": "workspace:8.0.0-rc.11",
    "@repo/tsconfig": "workspace:8.0.0-rc.11",
    "@repo/tsdown": "workspace:8.0.0-rc.11",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./config-types": "./dist/config-types.mjs",
    "./contract-builder": "./dist/contract-builder.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/orm.git",
    "directory": "packages/2-mongo-family/2-authoring/contract-ts"
  }
}
