{
  "name": "@internal/sql-contract-ts",
  "private": true,
  "version": "8.0.0-rc.5",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "SQL-specific TypeScript contract authoring surface for Prisma Next",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "schemas:generate": "tsx scripts/generate-json-schema.ts && biome format --write schemas/data-contract-sql-v1.json",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/config": "workspace:8.0.0-rc.5",
    "@internal/contract": "workspace:8.0.0-rc.5",
    "@internal/contract-authoring": "workspace:8.0.0-rc.5",
    "@internal/framework-components": "workspace:8.0.0-rc.5",
    "@internal/sql-contract": "workspace:8.0.0-rc.5",
    "@internal/sql-schema-ir": "workspace:8.0.0-rc.5",
    "@internal/utils": "workspace:8.0.0-rc.5",
    "arktype": "^2.2.2",
    "pathe": "^2.0.3",
    "ts-toolbelt": "^9.6.0"
  },
  "devDependencies": {
    "@repo/test-utils": "workspace:8.0.0-rc.5",
    "@repo/tsconfig": "workspace:8.0.0-rc.5",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "@repo/tsdown": "workspace:8.0.0-rc.5",
    "ajv": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "schemas"
  ],
  "exports": {
    "./config-types": "./dist/config-types.mjs",
    "./contract-builder": "./dist/contract-builder.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/2-sql/2-authoring/contract-ts"
  }
}
