{
  "name": "@internal/errors",
  "private": true,
  "version": "8.0.0-rc.5",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Structured error types for Prisma Next control and execution planes",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/framework-components": "workspace:8.0.0-rc.5",
    "@internal/utils": "workspace:8.0.0-rc.5"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:8.0.0-rc.5",
    "@repo/tsdown": "workspace:8.0.0-rc.5",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./control": "./dist/control.mjs",
    "./execution": "./dist/execution.mjs",
    "./migration": "./dist/migration.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/1-framework/1-core/errors"
  }
}
