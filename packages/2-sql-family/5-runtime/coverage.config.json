{
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist/**",
    "test/**",
    "**/*.test.ts",
    "**/*.test-d.ts",
    "**/*.config.ts",
    "**/exports/**",
    "src/lower-sql-plan.ts",
    "src/codecs/encoding.ts",
    "src/codecs/decoding.ts",
    "src/codecs/validation.ts",
    "src/guardrails/raw.ts",
    "src/runtime-spi.ts",
    "src/middleware/sql-middleware.ts"
  ],
  "thresholds": {
    "lines": 90,
    "branches": 80,
    "functions": 92,
    "statements": 90
  }
}
