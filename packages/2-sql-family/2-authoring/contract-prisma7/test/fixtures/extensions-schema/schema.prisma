datasource db {
  provider   = "postgresql"
  schemas    = ["public", "extensions"]
  extensions = [pg_trgm(schema: "extensions")]
}

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id Int @id

  @@schema("public")
}
