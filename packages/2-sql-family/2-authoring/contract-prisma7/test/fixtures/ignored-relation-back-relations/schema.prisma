datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id
  managerId Int?
  manager   User?    @relation("Manager", fields: [managerId], references: [id]) @ignore
  managed   User[]   @relation("Manager")
  posts     Post[]
  profile   Profile?
  tags      Tag[]
}

model Post {
  id       Int  @id
  authorId Int
  author   User @relation(fields: [authorId], references: [id]) @ignore
}

model Profile {
  id     Int  @id
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id]) @ignore
}

model Tag {
  id    Int    @id
  users User[] @ignore
}
