{
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist/**",
    "test/**",
    "**/*.test.ts",
    "**/*.test-d.ts",
    "**/*.config.ts",
    "**/exports/**",
    "**/types.ts",
    "src/index.ts",
    "src/pack-types.ts",
    "src/ir/sql-storage.ts",
    "src/ir/storage-column.ts",
    "src/ir/storage-table.ts",
    "src/ir/storage-type-instance.ts",
    "src/ir/unique-constraint.ts",
    "src/index-type-validation.ts"
  ],
  "thresholds": {
    "lines": 90,
    "branches": 85,
    "functions": 92,
    "statements": 91
  }
}
