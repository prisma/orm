{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-*",
      "!**/coverage",
      "!**/node_modules",
      "!**/.prisma",
      "!**/*.d.ts",
      "!**/*.svg",
      "!**/contract.json",
      "!**/sql-contract.json",
      "!**/mongo-contract.json",
      "!**/migrations/*/*/migration.json",
      "!**/migrations/*/*/ops.json",
      "!**/planner-golden/fixtures/*/planned.golden.json",
      // Declaration files written the way the bundler writes them, as input to scripts/public-api.
      "!scripts/public-api/fixtures/**/*.d.mts",
      // A package.json that cannot be parsed, as input to scripts/public-api.
      "!scripts/public-api/fixtures/root-broken/packages/9-public/@prisma/malformed/package.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "plugins": [
    "./biome-plugins/no-bare-cast.grit",
    "./biome-plugins/no-bare-throw.grit",
    "./biome-plugins/no-family-vocabulary.grit"
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": []
  },
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test-d.ts", "**/test/**/*.ts"],
      "javascript": {
        "globals": ["console", "process", "__dirname", "__filename", "URL"]
      },
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    // An upgrade script fixture holds the files a script reads and writes, byte for byte.
    {
      "includes": ["**/upgrade-instructions/*/fixtures/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    }
  ]
}
