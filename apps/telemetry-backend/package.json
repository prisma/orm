{
  "name": "telemetry-backend",
  "version": "8.0.0-rc.5",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "scripts": {
    "deploy": "bun run scripts/deploy.ts",
    "emit": "prisma contract emit",
    "emit:check": "pnpm emit && git diff --exit-code src/prisma/contract.json src/prisma/contract.d.ts",
    "migrate": "prisma migrate",
    "start": "bun run src/server.ts",
    "start:node": "tsx src/server-node.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@prisma/orm-postgres": "workspace:8.0.0-rc.5",
    "arktype": "catalog:",
    "evlog": "^2.24.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.0",
    "@prisma/compute-sdk": "^0.39.0",
    "@prisma/management-api-sdk": "^1.56.0",
    "@repo/test-utils": "workspace:8.0.0-rc.5",
    "@repo/tsconfig": "workspace:8.0.0-rc.5",
    "@types/bun": "^1.2.18",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pathe": "^2.0.3",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
