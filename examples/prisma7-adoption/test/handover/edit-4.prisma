generator client {
  provider = "prisma-client"
  output   = "../generated/prisma7"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?  @ignore
  published Boolean @default(false)
  viewCount Int     @default(autoincrement())
  likes     Int?
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id], map: "Post_author_fk")
  tags      Tag[]
  comments  Comment[] @ignore

  @@index([authorId])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])

  @@ignore
}
