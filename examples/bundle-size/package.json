{
  "name": "bundle-size",
  "private": true,
  "type": "module",
  "version": "8.0.0-rc.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:pg": "tsx src/postgres/main.ts",
    "start:pg:emit": "tsx src/postgres/main-emit.ts",
    "start:mongo": "tsx src/mongo/main.ts",
    "start:mongo:emit": "tsx src/mongo/main-emit.ts",
    "emit:pg": "prisma contract emit --config src/postgres/prisma.config.ts",
    "emit:mongo": "prisma contract emit --config src/mongo/prisma.config.ts",
    "emit": "pnpm emit:pg && pnpm emit:mongo",
    "bundle": "tsx scripts/bundle.ts",
    "size": "size-limit",
    "size:build": "pnpm --dir ../.. run build && pnpm bundle",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings"
  },
  "dependencies": {
    "@prisma/orm-mongo": "workspace:8.0.0-rc.5",
    "@prisma/orm-postgres": "workspace:8.0.0-rc.5",
    "mongodb": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.0",
    "@prisma/dev": "catalog:",
    "@repo/test-utils": "workspace:8.0.0-rc.5",
    "@repo/tsconfig": "workspace:8.0.0-rc.5",
    "@size-limit/file": "^12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "catalog:",
    "size-limit": "^12.1.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.119.0"
  }
}
