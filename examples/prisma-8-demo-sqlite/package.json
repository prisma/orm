{
  "name": "prisma-8-demo-sqlite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "emit": "prisma contract emit",
    "emit:check": "pnpm emit && git diff --exit-code src/prisma/contract.json src/prisma/contract.d.ts",
    "db:init": "prisma db init",
    "seed": "tsx scripts/seed.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings"
  },
  "dependencies": {
    "@prisma/orm-family-sql": "workspace:8.0.0-rc.25",
    "@prisma/orm-framework": "workspace:8.0.0-rc.25",
    "@prisma/orm-sqlite": "workspace:8.0.0-rc.25",
    "@prisma/orm-target-sqlite": "workspace:8.0.0-rc.25",
    "@prisma/orm-toolchain": "workspace:8.0.0-rc.25",
    "arktype": "^2.2.9",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.10.4",
    "@repo/prisma-bin": "workspace:8.0.0-rc.25",
    "@repo/tsconfig": "workspace:8.0.0-rc.25",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": "8.0.0-rc.25"
}
