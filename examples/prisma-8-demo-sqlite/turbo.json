{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "prisma/**",
        "src/**",
        "test/**",
        "prisma.config.ts",
        "vitest.config.ts",
        "tsconfig.json"
      ],
      "env": ["TEST_TIMEOUT_MULTIPLIER", "SQLITE_PATH"]
    }
  }
}
