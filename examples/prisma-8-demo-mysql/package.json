{
  "name": "prisma-8-demo-mysql",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "emit": "prisma contract emit",
    "emit:check": "pnpm emit && git diff --exit-code src/prisma/contract.json src/prisma/contract.d.ts",
    "migration:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings"
  },
  "dependencies": {
    "@prisma/orm-mysql": "workspace:8.0.0-rc.22"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@repo/prisma-bin": "workspace:8.0.0-rc.22",
    "@repo/tsconfig": "workspace:8.0.0-rc.22",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": "8.0.0-rc.22"
}
