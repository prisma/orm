    "format/contract.prisma": [
      "// use prisma-8",
      "",
      "model    mixin   Timestamps{",
      "createdAt DateTime @default( now( ) )",
      "      updatedAt      DateTime   @default(now())",
      "@@index( [createdAt] )",
      "}",
      "",
      "enum mixin BaseRoles {",
      "      ADMIN = \"admin\"",
      " USER=\"user\"",
      "}",
      "",
      "enum Role {",
      "  @@type(\"pg/text@1\")",
      "     +   BaseRoles",
      "  GUEST = \"guest\"",
      "}",
      "",
      "namespace auth {",
      "model mixin Owned { ownerId Int }",
      "}",
      "",
      "model User {",
      "  id Int @id",
      "+Timestamps",
      "        +  auth . Owned",
      "  email String // trailing",
      "  role Role",
      "}",
      ""
    ],
