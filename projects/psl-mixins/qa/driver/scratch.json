{
  "files": {
    "db/contract.prisma": [
      "// use prisma-8",
      "",
      "model mixin Timestamps {",
      "  createdAt DateTime @default(now())",
      "  updatedAt DateTime @default(now())",
      "",
      "  @@index([createdAt])",
      "}",
      "",
      "enum mixin BaseRoles {",
      "  ADMIN = \"admin\"",
      "  USER  = \"user\"",
      "}",
      "",
      "enum Role {",
      "  @@type(\"pg/text@1\")",
      "  +BaseRoles",
      "  GUEST = \"guest\"",
      "}",
      "",
      "namespace public {",
      "  model Profile {",
      "    id        Int    @id",
      "    +Timestamps",
      "    ownerName String",
      "    role      Role",
      "",
      "    @@rls",
      "  }",
      "",
      "  model Document {",
      "    id        Int    @id",
      "    ownerName String",
      "    +Timestamps",
      "",
      "    @@rls",
      "  }",
      "",
      "  policy_select mixin OwnerRead {",
      "    roles = [app_user]",
      "    using = sql`\"ownerName\" = current_user`",
      "  }",
      "",
      "  policy_select profile_owner_read {",
      "    target = Profile",
      "    +OwnerRead",
      "  }",
      "",
      "  policy_select document_owner_read {",
      "    target = Document",
      "    +OwnerRead",
      "  }",
      "}",
      "",
      "namespace unbound {",
      "  role app_user {}",
      "}",
      ""
    ],
    "db/prisma.config.ts": [
      "import { definePrismaConfig } from '@prisma/cli-engine';",
      "import { defineConfig as ormConfig } from '@prisma/orm-postgres/config';",
      "",
      "export default definePrismaConfig({",
      "  orm: ormConfig({",
      "    contract: './contract.prisma',",
      "    db: { connection: process.env['DATABASE_URL'] ?? '' },",
      "    migrations: { dir: 'migrations' },",
      "  }),",
      "});",
      ""
    ],
    "emit/inline/contract.prisma": [
      "// use prisma-8",
      "",
      "enum Role {",
      "  @@type(\"pg/text@1\")",
      "  ADMIN = \"admin\"",
      "  USER  = \"user\"",
      "  GUEST = \"guest\"",
      "}",
      "",
      "namespace public {",
      "  model Profile {",
      "    id        Int      @id",
      "    createdAt DateTime @default(now())",
      "    updatedAt DateTime @default(now())",
      "    ownerName String",
      "    role      Role",
      "",
      "    @@index([createdAt])",
      "    @@rls",
      "  }",
      "",
      "  model Document {",
      "    id        Int      @id",
      "    ownerName String",
      "    createdAt DateTime @default(now())",
      "    updatedAt DateTime @default(now())",
      "",
      "    @@index([createdAt])",
      "    @@rls",
      "  }",
      "",
      "  policy_select profile_owner_read {",
      "    target = Profile",
      "    roles  = [app_user]",
      "    using  = sql`\"ownerName\" = current_user`",
      "  }",
      "",
      "  policy_select document_owner_read {",
      "    target = Document",
      "    roles  = [app_user]",
      "    using  = sql`\"ownerName\" = current_user`",
      "  }",
      "}",
      "",
      "namespace unbound {",
      "  role app_user {}",
      "}",
      ""
    ],
