    "sign/contract.prisma": [
      "// use prisma-8",
      "",
      "model mixin Counted {",
      "  plus    Int   @default(+1)",
      "  bare    Int   @default(1)",
      "  minus   Int   @default(-1)",
      "  ratio   Float @default(+1.5)",
      "}",
      "",
      "model Counter {",
      "  id Int @id",
      "  +Counted",
      "}",
      ""
