diff --git a/packages/3-extensions/sql-orm-client/test/where-unique-spike.types.test-d.ts b/packages/3-extensions/sql-orm-client/test/where-unique-spike.types.test-d.ts
new file mode 100644
index 0000000000..c3807f3386
--- /dev/null
+++ b/packages/3-extensions/sql-orm-client/test/where-unique-spike.types.test-d.ts
@@ -0,0 +1,90 @@
+import type { AsyncIterableResult } from '@internal/framework-components/runtime';
+import { describe, expectTypeOf, test } from 'vitest';
+import type { CollectionRowOf } from '../src/collection-types';
+import { Collection } from '../src/collection';
+import { createChainingOrm, type PostCollection } from './collection-chaining-fixture';
+import type { TestContract } from './helpers';
+
+const { db, plain } = createChainingOrm();
+const Post = db.Post;
+type Row = CollectionRowOf<PostCollection>;
+
+class ScopedPost extends Collection<TestContract, 'Post'> {
+  top() {
+    return this.orderBy((p) => p.views.desc()).limit(10).offset(0);
+  }
+  everything() {
+    return this.all();
+  }
+  total() {
+    return this.aggregate((a) => ({ n: a.count() }));
+  }
+  purge() {
+    return this.where({ id: 1 }).deleteAll();
+  }
+}
+
+describe('whereUnique spike', () => {
+  test('single-record operations keep their types', async () => {
+    const u = Post.whereUnique({ id: 1 });
+    expectTypeOf(await u.first()).toEqualTypeOf<Row | null>();
+    expectTypeOf(await u.update({ title: 'x' })).toEqualTypeOf<Row | null>();
+    expectTypeOf(await u.delete()).toEqualTypeOf<Row | null>();
+    expectTypeOf(await u.where({ title: 'x' }).first()).toEqualTypeOf<Row | null>();
+    expectTypeOf(await u.published().first()).toEqualTypeOf<Row | null>();
+    expectTypeOf(await u.select('id').first()).toEqualTypeOf<{ id: number } | null>();
+    const withAuthor = await u.include('author').first();
+    expectTypeOf(withAuthor).not.toBeAny();
+    expectTypeOf(withAuthor).toExtend<{ author: { name: string } } | null>();
+    expectTypeOf(await plain.Post.whereUnique({ id: 1 }).first()).not.toBeAny();
+  });
+
+  test('many-record operations are refused', () => {
+    const u = Post.whereUnique({ id: 1 });
+    // @ts-expect-error
+    u.all();
+    // @ts-expect-error
+    u.orderBy((p) => p.views.desc());
+    // @ts-expect-error
+    u.limit(1);
+    // @ts-expect-error
+    u.offset(1);
+    // @ts-expect-error
+    u.distinct('title');
+    // @ts-expect-error
+    u.aggregate((a) => ({ n: a.count() }));
+    // @ts-expect-error
+    u.updateAll({ title: 'x' });
+    // @ts-expect-error
+    u.updateAndCount({ title: 'x' });
+    // @ts-expect-error
+    u.deleteAll();
+    // @ts-expect-error
+    u.deleteAndCount();
+    // @ts-expect-error
+    u.where({ title: 'x' }).all();
+    // @ts-expect-error
+    u.include('author').all();
+    // @ts-expect-error
+    u.select('id').all();
+    // @ts-expect-error
+    u.published().all();
+    // @ts-expect-error
+    plain.Post.whereUnique({ id: 1 }).all();
+    // @ts-expect-error
+    Post.orderBy((p) => p.views.desc()).whereUnique({ id: 1 }).cursor({ views: 1 });
+  });
+
+  test('argument', () => {
+    // @ts-expect-error not a unique constraint
+    Post.whereUnique({ title: 'x' });
+    // @ts-expect-error object form only
+    Post.whereUnique((p) => p.id.eq(1));
+  });
+
+  test('collections without whereUnique are unchanged', () => {
+    expectTypeOf(Post.published().recent().limit(5).all()).toEqualTypeOf<AsyncIterableResult<Row>>();
+    expectTypeOf(Post.where({ id: 1 }).deleteAll()).toEqualTypeOf<AsyncIterableResult<Row>>();
+    expectTypeOf<ReturnType<ScopedPost['everything']>>().not.toBeAny();
+  });
+});
